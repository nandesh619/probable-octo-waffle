<Window x:Class="SshAdbHub.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH profile" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Profile name"/>
        <TextBox x:Name="NameBox" Margin="0,2,0,8"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Host / IP"/>
                <TextBox x:Name="HostBox" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Port"/>
                <TextBox x:Name="PortBox" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Username"/>
        <TextBox x:Name="UserBox" Margin="0,2,0,8"/>

        <TextBlock Text="Private key file (OpenSSH format, optional - leave empty for password login)"/>
        <DockPanel Margin="0,2,0,8">
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="8,2" Click="Browse_Click"/>
            <TextBox x:Name="KeyBox"/>
        </DockPanel>

        <TextBlock Text="Password (or key passphrase). Leave blank to keep the saved one."/>
        <DockPanel Margin="0,2,0,8">
            <Button DockPanel.Dock="Right" Content="Clear saved" Margin="6,0,0,0" Padding="8,2" Click="ClearSecret_Click"/>
            <PasswordBox x:Name="PassBox"/>
        </DockPanel>
        <TextBlock x:Name="SecretHint" Foreground="Gray" Margin="0,0,0,8"/>

        <CheckBox x:Name="AutoChk" Content="Auto-connect when the app starts" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
